datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Medication {
  id           String   @id @default(cuid())
  name         String
  dosage       String?
  frequency    String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedules    Schedule[]
  interactions InteractingDrug[]
}

model Schedule {
  id           String   @id @default(cuid())
  medicationId String
  time         DateTime
  taken        Boolean  @default(false)
  notes        String?

  medication Medication @relation(fields: [medicationId], references: [id])

  @@unique([medicationId, time])
}

model InteractingDrug {
  id                  String  @id @default(cuid())
  medicationId        String
  interactingDrugName String
  severity            String
  description         String?

  medication Medication @relation(fields: [medicationId], references: [id])
}

model PrescriptionScan {
  id                String      @id @default(cuid())
  patientName       String      @default("Unknown Patient")
  recordDate        String
  source            String
  scannedAt         DateTime    @default(now())
  medications       Json
  drugInteractions  Json
  
  // 🚀 NEW: Added to persist Groq's lifestyle and dietary advice
  lifestyleWarnings Json?      
  
  // RELATION: Links this scan to its collection of daily logged biometrics
  vitalsLogs        VitalsLog[]

  @@map("prescription_scans")
}

model VitalsLog {
  id           String           @id @default(cuid())
  scanId       String           
  recordedAt   DateTime         @default(now())
  heartRate    Int              // Cardiovascular pulse (BPM)
  systolicBP   Int              // Upper blood pressure metric (mmHg)
  diastolicBP  Int              // Lower blood pressure metric (mmHg)
  
  // Relationship linking back to the prescription scan row with automatic cascade deletes
  prescription PrescriptionScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}
